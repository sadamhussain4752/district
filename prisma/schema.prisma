// Indiramma Illu Management Tool — data model
// Client: EESHA INFRA GLOBAL PRIVATE LIMITED
// Database: MongoDB (replica set required) via Prisma

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  STATE_ADMIN
  DISTRICT_MANAGER
  PROJECT_MANAGER
  SITE_ENGINEER
  CONTRACTOR
  LABOUR_VENDOR
  STORE_MANAGER
  ACCOUNTS
  AUDITOR
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum BeneficiaryStatus {
  APPLIED
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
  APPROVED
  HOUSE_ALLOTTED
  CONSTRUCTION_NOT_STARTED
  CONSTRUCTION_STARTED
  UNDER_CONSTRUCTION
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum HouseStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_CONSTRUCTION
  DELAYED
  ON_HOLD
  COMPLETED
  HANDED_OVER
}

enum StageStatus {
  NOT_STARTED
  STARTED
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  COMPLETED
  REJECTED
  REWORK_REQUIRED
}

enum ScheduleHealth {
  ON_SCHEDULE
  AT_RISK
  DELAYED
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum PhotoType {
  BEFORE
  DURING
  AFTER
}

enum ApprovalType {
  BENEFICIARY_VERIFICATION
  MATERIAL_REQUEST
  PURCHASE_ORDER
  EXPENSE
  CONTRACTOR_BILL
  STAGE_VERIFICATION
  STOCK_TRANSFER
  PAYMENT_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  PM_APPROVED
  ACCOUNTS_APPROVED
  REJECTED
  PAID
}

enum PaymentMilestone {
  FOUNDATION
  PLINTH
  ROOF
  COMPLETION
}

enum PaymentStatus {
  ELIGIBLE
  SUBMITTED
  VERIFICATION
  APPROVED
  PROCESSING
  PAID
  FAILED
  RETURNED
}

enum StockTxnType {
  OPENING
  PURCHASE_RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  ISSUE
  RETURN
  ADJUSTMENT
}

enum MaterialRequestStatus {
  REQUESTED
  PM_APPROVED
  STORE_APPROVED
  PARTIALLY_ISSUED
  ISSUED
  RECEIVED
  CLOSED
  REJECTED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  RECEIVED
  VERIFIED
  CLOSED
}

enum InspectionResult {
  PASSED
  PASSED_WITH_OBSERVATION
  FAILED
  REWORK_REQUIRED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
}

enum WarehouseLevel {
  STATE
  DISTRICT
  MANDAL
  PROJECT
  SITE
}

enum DocEntity {
  BENEFICIARY
  HOUSE
  PROJECT
  CONTRACTOR
  EXPENSE
  PURCHASE
  PAYMENT
  STAGE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  PAYMENT
  STOCK_ISSUE
  STOCK_ADJUSTMENT
  STAGE_CHANGE
  LOGIN
  LOGOUT
  DOCUMENT_VERIFICATION
  SENSITIVE_VIEW
}

// ---------------------------------------------------------------------------
// AUTH / USERS
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  employeeId    String     @unique
  name          String
  email         String     @unique
  mobile        String?
  passwordHash  String
  role          Role
  department    String?
  status        UserStatus @default(ACTIVE)
  permissions   String[]   @default([])

  stateId       String?    @db.ObjectId
  districtId    String?    @db.ObjectId
  mandalId      String?    @db.ObjectId
  projectIds    String[]   @db.ObjectId

  lastLoginAt   DateTime?
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdBy     String?
  updatedBy     String?

  refreshTokens RefreshToken[]

  @@index([role])
  @@index([districtId])
}

model RefreshToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  family     String
  userAgent  String?
  ip         String?
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// LOCATION HIERARCHY
// ---------------------------------------------------------------------------

model State {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts District[]
}

model District {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  code         String   @unique
  name         String
  stateId      String   @db.ObjectId
  state        State    @relation(fields: [stateId], references: [id])
  geoKey       String?  // key used to match GeoJSON feature
  headquarters String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mandals       Mandal[]
  beneficiaries Beneficiary[]
  houses        House[]

  @@index([stateId])
}

model Mandal {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String   @unique
  name       String
  districtId String   @db.ObjectId
  district   District @relation(fields: [districtId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  villages      Village[]
  beneficiaries Beneficiary[]
  houses        House[]

  @@index([districtId])
}

model Village {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  name      String
  mandalId  String   @db.ObjectId
  mandal    Mandal   @relation(fields: [mandalId], references: [id])
  pinCode   String?
  isUrban   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries Beneficiary[]
  houses        House[]

  @@index([mandalId])
}

// ---------------------------------------------------------------------------
// PROJECTS
// ---------------------------------------------------------------------------

model Project {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  code               String        @unique
  name               String
  stateId            String        @db.ObjectId
  districtId         String        @db.ObjectId
  mandalId           String?       @db.ObjectId
  villageId          String?       @db.ObjectId
  financialYear      String
  plannedHouses      Int           @default(0)
  approvedBudget     Float         @default(0)
  startDate          DateTime?
  targetDate         DateTime?
  projectManagerId   String?       @db.ObjectId
  contractorId       String?       @db.ObjectId
  status             ProjectStatus @default(PLANNING)
  progressPct        Float         @default(0)
  totalExpenditure   Float         @default(0)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdBy          String?
  updatedBy          String?

  @@index([districtId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// BENEFICIARIES
// ---------------------------------------------------------------------------

model Beneficiary {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  beneficiaryCode   String            @unique
  applicationNo     String            @unique
  applicationId     String?           @unique // govt application id e.g. 257970/461770
  astCode           String?           // Astonic internal code e.g. AST-590
  registrationNo    String?
  name              String
  guardianName      String?
  gender            String?
  dob               DateTime?

  aadhaarLast4      String?
  aadhaarHash       String?           // hashed full aadhaar, never stored in plain
  mobile            String?
  altMobile         String?

  bankAccountLast4  String?
  bankAccountEnc    String?
  ifsc              String?
  bankName          String?

  // ICICI disbursement card / account (Indiramma payment rail)
  iciciAccountLast4 String?
  iciciAccountEnc   String?
  referenceNumber   String?
  cmsAccountStatus  String?           // ACTIVE / LOST-STOLEN / CLOSED
  cardHolderName    String?

  sft               String?           // house size band e.g. "400-SFT"
  initialListType   String?           // List 1 / List 2 / List 3
  mouDate           DateTime?
  mouStatus         String?

  address           String?
  stateId           String            @db.ObjectId
  districtId        String            @db.ObjectId
  district          District          @relation(fields: [districtId], references: [id])
  mandalId          String            @db.ObjectId
  mandal            Mandal            @relation(fields: [mandalId], references: [id])
  villageId         String            @db.ObjectId
  village           Village           @relation(fields: [villageId], references: [id])
  pinCode           String?
  latitude          Float?
  longitude         Float?

  scheme            String?
  financialYear     String?
  sanctionNo        String?
  sanctionDate      DateTime?
  sanctionAmount    Float             @default(0)
  houseType         String?
  plotDetails       String?
  landOwnership     String?

  status            BeneficiaryStatus @default(APPLIED)

  projectId         String?           @db.ObjectId
  contractorId      String?           @db.ObjectId
  projectManagerId  String?           @db.ObjectId

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  updatedBy         String?

  house             House?
  payments          BeneficiaryPayment[]
  cards             BeneficiaryCard[]
  cashCollections   CashCollection[]

  @@index([districtId])
  @@index([mandalId])
  @@index([status])
  @@index([projectId])
  @@index([astCode])
}

// Payment card issued to a beneficiary (CMS portal export).
model BeneficiaryCard {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  beneficiaryId  String?      @db.ObjectId
  beneficiary    Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  applicationId  String?
  cardNumberLast4 String?
  cardNumberEnc  String?
  holderName     String?
  status         String?      // ACTIVE / LOST-STOLEN / CLOSED
  accountNumber  String?
  accountBalance Float        @default(0)
  ledgerBalance  Float        @default(0)
  currency       String       @default("INR")
  productName    String?      // VISA PAYDIRECT CARDS
  cardType       String?      // UMANG CARD CONTACTLESS EMV
  aadhaarLast4   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([beneficiaryId])
  @@index([applicationId])
  @@index([status])
}

// Cash collected from a beneficiary toward their contribution (Cash_Transaction sheet).
model CashCollection {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  beneficiaryId String?      @db.ObjectId
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  applicationId String?
  date          DateTime?
  districtId    String?      @db.ObjectId
  stageKey      String?
  collectedBy   String?      // person name
  amount        Float        @default(0)
  remarks       String?
  createdAt     DateTime     @default(now())

  @@index([beneficiaryId])
  @@index([applicationId])
}

// Labour contractor (site gang lead). Names in the source are inconsistent; normalised on import.
model LabourContractor {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String   @unique
  districtIds  String[] @db.ObjectId
  totalHouses  Int      @default(0)
  totalPaid    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// HOUSES / CONSTRUCTION UNITS
// ---------------------------------------------------------------------------

model House {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  houseCode          String         @unique
  beneficiaryId      String         @unique @db.ObjectId
  beneficiary        Beneficiary    @relation(fields: [beneficiaryId], references: [id])

  projectId          String?        @db.ObjectId
  stateId            String         @db.ObjectId
  districtId         String         @db.ObjectId
  district           District       @relation(fields: [districtId], references: [id])
  mandalId           String         @db.ObjectId
  mandal             Mandal         @relation(fields: [mandalId], references: [id])
  villageId          String         @db.ObjectId
  village            Village        @relation(fields: [villageId], references: [id])

  contractorId       String?        @db.ObjectId
  projectManagerId   String?        @db.ObjectId
  engineerId         String?        @db.ObjectId
  supervisorId       String?        @db.ObjectId
  labourVendorId     String?        @db.ObjectId

  startDate          DateTime?
  plannedCompletion  DateTime?
  actualCompletion   DateTime?

  estimatedCost      Float          @default(0)
  actualCost         Float          @default(0)

  currentStageKey    String?
  currentStageName   String?
  progressPct        Float          @default(0)
  status             HouseStatus    @default(NOT_STARTED)
  scheduleHealth     ScheduleHealth @default(ON_SCHEDULE)
  healthScore        Int            @default(100)

  delayReason        String?
  delayResponsible   String?
  correctiveAction   String?
  expectedResolution DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdBy          String?
  updatedBy          String?

  stageProgress      HouseStageProgress[]
  photos             StagePhoto[]

  @@index([districtId])
  @@index([mandalId])
  @@index([status])
  @@index([contractorId])
  @@index([projectManagerId])
}

model ConstructionStage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique
  sequence     Int
  name         String
  shortName    String?
  isMandatory  Boolean  @default(true)
  needsQC      Boolean  @default(false)
  paymentMilestone PaymentMilestone?
  weightPct    Float    @default(0)
  billValue    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HouseStageProgress {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  houseId        String      @db.ObjectId
  house          House       @relation(fields: [houseId], references: [id], onDelete: Cascade)
  stageKey       String
  stageName      String
  sequence       Int

  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  progressPct    Float       @default(0)
  stageCost      Float       @default(0)
  status         StageStatus @default(NOT_STARTED)

  supervisorId   String?     @db.ObjectId
  contractorId   String?     @db.ObjectId
  labourVendorId String?     @db.ObjectId
  remarks        String?

  qcResult       InspectionResult?
  approvalStatus ApprovalStatus @default(PENDING)

  // Operational fields from the Astonic / Indiramma workflow
  onlineStatus        String?   // Entry_Pending / AE / PD / Collector / EE / CE / MD / MD-Approve Payment Done
  offlineStage        String?
  labourContractorName String?
  supervisorName      String?
  capturedOn          DateTime?

  billValue      Float       @default(0)
  receivedAmount Float       @default(0)
  balanceAmount  Float       @default(0)
  paymentMode    String?
  paymentDate    DateTime?
  paymentBankName String?
  utrNumber      String?

  // Approval-chain checkpoint dates (PS -> AE -> PD -> Collector -> EE -> CE -> MD)
  psDate         DateTime?
  aeDate         DateTime?
  pdDate         DateTime?
  collectorDate  DateTime?
  eeDate         DateTime?
  ceDate         DateTime?
  mdDate         DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  updatedBy      String?

  @@index([houseId])
  @@index([status])
  @@index([stageKey])
  @@index([onlineStatus])
}

model StagePhoto {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  houseId       String    @db.ObjectId
  house         House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  stageKey      String?
  url           String
  photoType     PhotoType @default(DURING)
  description   String?
  latitude      Float?
  longitude     Float?
  takenAt       DateTime?
  uploadedById  String?   @db.ObjectId
  createdAt     DateTime  @default(now())

  @@index([houseId])
}

// ---------------------------------------------------------------------------
// CONTRACTORS / SUPERVISORS / LABOUR
// ---------------------------------------------------------------------------

model Contractor {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  contractorCode   String   @unique
  companyName      String
  ownerName        String?
  gstin            String?
  pan              String?
  registrationNo   String?
  contactPhone     String?
  email            String?
  address          String?
  bankName         String?
  bankAccountEnc   String?
  ifsc             String?

  districtIds      String[] @db.ObjectId
  mandalIds        String[] @db.ObjectId

  contractValue    Float    @default(0)
  securityDeposit  Float    @default(0)
  startDate        DateTime?
  completionDate   DateTime?
  status           String   @default("ACTIVE")

  performanceScore Float    @default(0)
  qualityScore     Float    @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Supervisor {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  supervisorCode String  @unique
  name          String
  mobile        String?
  userId        String?  @db.ObjectId
  contractorId  String?  @db.ObjectId
  districtId    String?  @db.ObjectId
  mandalId      String?  @db.ObjectId
  projectId     String?  @db.ObjectId
  activeSites   Int      @default(0)
  lastVisitAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LabourVendor {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorCode    String   @unique
  name          String
  contactPhone  String?
  trade         String?
  contractorId  String?  @db.ObjectId
  districtId    String?  @db.ObjectId
  mandalId      String?  @db.ObjectId
  projectId     String?  @db.ObjectId
  workerCount   Int      @default(0)
  rateType      String?  // DAILY | CONTRACT | QUANTITY
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  labourEntries LabourEntry[]
}

model LabourEntry {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  vendorId       String       @db.ObjectId
  vendor         LabourVendor @relation(fields: [vendorId], references: [id])
  houseId        String?      @db.ObjectId
  stageKey       String?
  date           DateTime
  skilled        Int          @default(0)
  unskilled      Int          @default(0)
  masons         Int          @default(0)
  helpers        Int          @default(0)
  electricians   Int          @default(0)
  plumbers       Int          @default(0)
  painters       Int          @default(0)
  totalAttendance Int         @default(0)
  rate           Float        @default(0)
  totalAmount    Float        @default(0)
  workDescription String?
  supervisorApproved Boolean  @default(false)
  createdAt      DateTime     @default(now())

  @@index([vendorId])
  @@index([houseId])
}

// ---------------------------------------------------------------------------
// DAILY PROGRESS REPORT
// ---------------------------------------------------------------------------

model DailyProgressReport {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  date             DateTime
  districtId       String   @db.ObjectId
  mandalId         String?  @db.ObjectId
  projectId        String?  @db.ObjectId
  houseId          String?  @db.ObjectId
  stageKey         String?
  todaysWork       String?
  pctToday         Float    @default(0)
  cumulativePct    Float    @default(0)
  labourCount      Int      @default(0)
  materialsUsed    String?
  problems         String?
  weatherImpact    String?
  photos           String[] @default([])
  remarks          String?
  tomorrowPlan     String?
  createdById      String?  @db.ObjectId
  createdAt        DateTime @default(now())

  @@index([date])
  @@index([districtId])
  @@index([houseId])
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

model Material {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  materialCode  String   @unique
  name          String
  category      String
  brand         String?
  specification String?
  unit          String
  reorderLevel  Float    @default(0)
  standardRate  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stock         InventoryStock[]
}

model Warehouse {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  code        String         @unique
  name        String
  level       WarehouseLevel
  stateId     String?        @db.ObjectId
  districtId  String?        @db.ObjectId
  mandalId    String?        @db.ObjectId
  projectId   String?        @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  stock       InventoryStock[]
}

model InventoryStock {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  materialId   String    @db.ObjectId
  material     Material  @relation(fields: [materialId], references: [id])
  warehouseId  String    @db.ObjectId
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  quantity     Float     @default(0)
  updatedAt    DateTime  @updatedAt

  @@unique([materialId, warehouseId])
  @@index([warehouseId])
}

model StockTransaction {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  txnNo        String       @unique
  type         StockTxnType
  materialId   String       @db.ObjectId
  warehouseId  String       @db.ObjectId
  toWarehouseId String?     @db.ObjectId
  quantity     Float
  balanceAfter Float        @default(0)
  projectId    String?      @db.ObjectId
  houseId      String?      @db.ObjectId
  contractorId String?      @db.ObjectId
  supervisorId String?      @db.ObjectId
  stageKey     String?
  purpose      String?
  reference    String?
  authorizedById String?    @db.ObjectId
  createdAt    DateTime     @default(now())

  @@index([materialId])
  @@index([warehouseId])
  @@index([houseId])
  @@index([type])
}

model MaterialRequest {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  requestNo    String                @unique
  houseId      String?               @db.ObjectId
  projectId    String?               @db.ObjectId
  districtId   String?               @db.ObjectId
  stageKey     String?
  requiredDate DateTime?
  purpose      String?
  status       MaterialRequestStatus @default(REQUESTED)
  requestedById String?              @db.ObjectId
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  items        MaterialRequestItem[]

  @@index([status])
}

model MaterialRequestItem {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  requestId   String          @db.ObjectId
  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId  String          @db.ObjectId
  requiredQty Float
  issuedQty   Float           @default(0)
}

model PurchaseOrder {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  poNo         String         @unique
  poDate       DateTime       @default(now())
  supplierId   String?        @db.ObjectId
  warehouseId  String?        @db.ObjectId
  districtId   String?        @db.ObjectId
  status       PurchaseStatus @default(DRAFT)
  subTotal     Float          @default(0)
  gst          Float          @default(0)
  transport    Float          @default(0)
  otherCharges Float          @default(0)
  total        Float          @default(0)
  invoiceNo    String?
  vehicleNo    String?
  receivedById String?        @db.ObjectId
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items        PurchaseItem[]
  grns         Grn[]
}

model PurchaseItem {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  poId         String        @db.ObjectId
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  materialId   String        @db.ObjectId
  quantity     Float
  unit         String
  rate         Float
  amount       Float         @default(0)
}

model Grn {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  grnNo        String        @unique
  poId         String?       @db.ObjectId
  po           PurchaseOrder? @relation(fields: [poId], references: [id])
  supplierId   String?       @db.ObjectId
  warehouseId  String?       @db.ObjectId
  date         DateTime      @default(now())
  invoiceNo    String?
  vehicleNo    String?
  receivedById String?       @db.ObjectId
  qcStatus     VerificationStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  items        GrnItem[]
}

model GrnItem {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  grnId        String @db.ObjectId
  grn          Grn    @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materialId   String @db.ObjectId
  orderedQty   Float  @default(0)
  receivedQty  Float  @default(0)
  rejectedQty  Float  @default(0)
  acceptedQty  Float  @default(0)
}

model MaterialConsumption {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  houseId      String   @db.ObjectId
  stageKey     String
  materialId   String   @db.ObjectId
  expectedQty  Float    @default(0)
  issuedQty    Float    @default(0)
  consumedQty  Float    @default(0)
  returnedQty  Float    @default(0)
  varianceQty  Float    @default(0)
  materialCost Float    @default(0)
  flagged      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([houseId])
}

model Supplier {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  gstin       String?
  contactPhone String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FINANCE
// ---------------------------------------------------------------------------

model Expense {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  expenseCode  String        @unique
  date         DateTime
  projectId    String?       @db.ObjectId
  districtId   String?       @db.ObjectId
  mandalId     String?       @db.ObjectId
  category     String
  description  String?
  amount       Float
  gst          Float         @default(0)
  paymentMode  String?
  paidBy       String?
  vendor       String?
  reference    String?
  invoiceUrl   String?
  status       ExpenseStatus @default(DRAFT)
  createdById  String?       @db.ObjectId
  approvedById String?       @db.ObjectId
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([districtId])
}

model GovernmentFund {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  releaseNo     String   @unique
  financialYear String
  sanctionNo    String?
  releaseDate   DateTime
  amount        Float
  department    String?
  districtId    String?  @db.ObjectId
  projectId     String?  @db.ObjectId
  documentUrl   String?
  createdAt     DateTime @default(now())

  @@index([financialYear])
}

model BeneficiaryPayment {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  beneficiaryId String           @db.ObjectId
  beneficiary   Beneficiary      @relation(fields: [beneficiaryId], references: [id])
  houseId       String?          @db.ObjectId
  milestone     PaymentMilestone
  eligibleAmount Float           @default(0)
  releasedAmount Float           @default(0)
  status        PaymentStatus    @default(ELIGIBLE)
  txnRef        String?
  bankName      String?
  paymentDate   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([beneficiaryId])
  @@index([status])
}

model ContractorBill {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  raBillNo          String   @unique
  contractorId      String   @db.ObjectId
  projectId         String?  @db.ObjectId
  periodFrom        DateTime?
  periodTo          DateTime?
  houseCount        Int      @default(0)
  workCompletedDesc String?
  measurementAmount Float    @default(0)
  materialDeduction Float    @default(0)
  advanceDeduction  Float    @default(0)
  retention         Float    @default(0)
  taxes             Float    @default(0)
  netPayable        Float    @default(0)
  status            String   @default("CONTRACTOR_SUBMITTED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             ContractorBillItem[]

  @@index([contractorId])
}

model ContractorBillItem {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  billId    String         @db.ObjectId
  bill      ContractorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  houseId   String?        @db.ObjectId
  activity  String
  quantity  Float          @default(0)
  unit      String?
  rate      Float          @default(0)
  amount    Float          @default(0)
}

model Measurement {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  houseId        String   @db.ObjectId
  activity       String
  quantity       Float    @default(0)
  unit           String?
  approvedRate   Float    @default(0)
  measuredQty    Float    @default(0)
  amount         Float    @default(0)
  engineerId     String?  @db.ObjectId
  measurementDate DateTime @default(now())
  photoUrl       String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime @default(now())

  @@index([houseId])
}

// ---------------------------------------------------------------------------
// QUALITY / ISSUES / DOCS
// ---------------------------------------------------------------------------

model QualityInspection {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  inspectionNo String          @unique
  houseId      String          @db.ObjectId
  stageKey     String
  inspectorId  String?         @db.ObjectId
  inspectionDate DateTime      @default(now())
  checklist    Json?
  remarks      String?
  score        Int             @default(0)
  result       InspectionResult @default(PASSED)
  photos       String[]        @default([])
  createdAt    DateTime        @default(now())

  @@index([houseId])
}

model Issue {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  issueCode   String        @unique
  priority    IssuePriority @default(MEDIUM)
  category    String
  houseId     String?       @db.ObjectId
  projectId   String?       @db.ObjectId
  districtId  String?       @db.ObjectId
  raisedById  String?       @db.ObjectId
  assignedToId String?      @db.ObjectId
  description String
  photos      String[]      @default([])
  dueDate     DateTime?
  status      IssueStatus   @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([priority])
}

model Document {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  entity        DocEntity
  entityId      String             @db.ObjectId
  docType       String
  fileUrl       String
  uploadedById  String?            @db.ObjectId
  verifiedById  String?            @db.ObjectId
  status        VerificationStatus @default(PENDING)
  expiryDate    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// WORKFLOW / SYSTEM
// ---------------------------------------------------------------------------

model Approval {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  type         ApprovalType
  entityId     String         @db.ObjectId
  entityLabel  String?
  districtId   String?        @db.ObjectId
  requestedById String?       @db.ObjectId
  requestedAt  DateTime       @default(now())
  status       ApprovalStatus @default(PENDING)
  decidedById  String?        @db.ObjectId
  decidedAt    DateTime?
  remarks      String?
  previousValue Json?
  newValue     Json?

  @@index([status])
  @@index([type])
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  role       Role?
  districtId String?  @db.ObjectId
  category   String
  title      String
  body       String?
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?     @db.ObjectId
  userName   String?
  role       Role?
  action     AuditAction
  module     String
  recordId   String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorName  String
  actorRole  Role?
  verb       String
  summary    String
  districtId String?  @db.ObjectId
  link       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Counter {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value Int    @default(0)
}
