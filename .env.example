# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — set these in Vercel: Project → Settings → Environment Variables
# (add for Production, Preview and Development), then redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string. Prisma + MongoDB needs a REPLICA SET.
# Production: MongoDB Atlas (free M0 tier is a replica set out of the box).
#   1. https://cloud.mongodb.com → create a free cluster
#   2. Database Access → add a user (username + password)
#   3. Network Access → add 0.0.0.0/0  (Vercel has no fixed egress IPs)
#   4. Connect → Drivers → copy the SRV string, add the db name before the "?"
# Example:
#   mongodb+srv://iiuser:PASSWORD@cluster0.ab1cd.mongodb.net/indiramma_illu?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/indiramma_illu?retryWrites=true&w=majority"

# Auth secrets — generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-generate-a-long-random-string"
JWT_REFRESH_SECRET="change-me-generate-a-different-long-random-string"

# One-time DB seed endpoint guard (POST /api/admin/bootstrap). Any random string.
BOOTSTRAP_SECRET="change-me-random-string"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — sensible defaults exist in code
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL="43200"        # seconds (12h)
REFRESH_TOKEN_TTL="1209600"     # seconds (14d)
NEXT_PUBLIC_DEPLOY_STATE="TG"   # TG (Telangana) or AP (Andhra Pradesh)
NEXT_PUBLIC_APP_NAME="Indiramma Illu Management System"

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV ONLY — `npm run dev` starts an in-memory MongoDB replica set and
# points here automatically; you normally don't touch this file for local work.
#   DATABASE_URL="mongodb://127.0.0.1:27017/indiramma_illu?replicaSet=rs0&directConnection=true"
# ─────────────────────────────────────────────────────────────────────────────
