{
  "name": "indiramma-illu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n db,web -c blue,green \"npm:db:local\" \"npm:dev:web\"",
    "dev:web": "next dev -p 3000",
    "db:local": "node scripts/mongo-dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
